# =============================================================================
# Room&Assets — Docker Environment Configuration
# =============================================================================
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker

# --- Required -----------------------------------------------------------------

# JWT secret for signing session cookies.
# Generate a strong random value, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-use-a-strong-random-secret

# MySQL connection string — matches the db service in docker-compose.yml
# Default credentials are fine for local dev; change in production.
DATABASE_URL=mysql://roomassets:roomassets_password@db:3306/roomassets

# --- Optional: OAuth (Manus) --------------------------------------------------
# Leave these empty if you are NOT using Manus OAuth.
# Without them all tRPC mutations run as publicProcedure (no auth required).

VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# --- Optional: Manus AI APIs --------------------------------------------------
# Only needed if you use the built-in AI chat / image generation features.

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
